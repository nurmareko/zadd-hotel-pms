// Hotel PMS — MVP Prisma Schema (Solo dev, 2-month timeline)
// Drop into prisma/schema.prisma and run `npx prisma migrate dev --name init`
//
// Changes vs full design (24 tables → 18 tables):
// - Rate inlined into RoomType (one fixed base rate per type)
// - GuestRegistrationCard inlined into Reservation (GRC metadata + signature)
// - Segment removed (no segment reporting)
// - MasterBill removed (no group billing)
// - ManualBill + ManualBillItem removed (walk-ins use Reservation.type = WALK_IN + Folio)
// - Outlet removed (single hardcoded outlet for F&B)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// ENUMS
// ============================================================

enum RoomStatus {
  VC // Vacant Clean
  OC // Occupied Clean
  VD // Vacant Dirty
  OD // Occupied Dirty
  VCU // Vacant Clean Unchecked
  OOO // Out of Order
}

enum ArticleType {
  ROOM
  FB
  SERVICE
  TAX
  MISC
}

enum ReservationStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum DepositStatus {
  PENDING
  COLLECTED
}

enum ReservationUsageType {
  REGULAR // normal hotel guest
  WALK_IN // ad-hoc non-staying guest (replaces ManualBill)
}

enum ArrangementType {
  RO // Room Only
  BB // Bed & Breakfast
  HB // Half Board
  FB // Full Board
}

enum ReservationStayFeeKind {
  EARLY_CHECK_IN
  LATE_CHECK_OUT
}

enum ReservationStayFeeStatus {
  PENDING
  POSTED
  CANCELLED
}

enum ReservationType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
  OTA // Online Travel Agent
  WALK_IN
}

enum GuestIdType {
  KTP
  PASSPORT
  KITAS
  KITAP
  SIM
  OTHER
}

enum FolioStatus {
  OPEN
  CLOSED
  VOIDED
}

enum FBOrderStatus {
  OPEN // captain order stage (being taken / in kitchen)
  BILLED // customer has been presented the bill
  CLOSED // paid
  VOIDED
}

enum FBOrderServiceType {
  DINE_IN
  ROOM_SERVICE
}

enum TableLocation {
  INDOOR
  OUTDOOR
  PRIVATE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHARGE_TO_ROOM
}

enum PaymentPurpose {
  DEPOSIT
  PAYMENT
  SETTLEMENT
}

enum NightAuditStatus {
  COMPLETED
}

enum LostFoundStatus {
  UNCLAIMED
  RETURNED
}

enum ActivityAction {
  RESERVATION_CREATED
  RESERVATION_UPDATED
  RESERVATION_CANCELLED
  CHECK_IN_COMPLETED
  CHECK_OUT_COMPLETED
  PAYMENT_RECORDED
  FOLIO_CHARGE_POSTED
}

enum PricingRuleSelectorKind {
  DAY_OF_WEEK
  DATE_RANGE
}

enum PricingRuleDayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PricingRuleAdjustmentKind {
  AMOUNT_DELTA
  PERCENT_DELTA
}

enum ReservationNightRevenueClass {
  PAID
  COMP
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  isSupervisor Boolean  @default(false) @map("is_supervisor")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                   UserRole[]
  reservationsCreated     Reservation[]            @relation("ReservationCreator")
  folioLineItemsPosted    FolioLineItem[]
  fbOrdersWaited          FBOrder[]
  housekeepingLogs        HousekeepingLog[]
  housekeepingAssignments HousekeepingAssignment[] @relation("HousekeepingAssignmentHousekeeper")
  cleaningSessions        CleaningSession[]        @relation("CleaningSessionHousekeeper")
  cleaningInspections     CleaningSession[]        @relation("CleaningSessionInspector")
  lostFoundItemsFound     LostFoundItem[]          @relation("LostFoundItemFoundBy")
  nightAuditsRun          NightAudit[]
  paymentsReceived        Payment[]
  stayFeesSelected        ReservationStayFee[]
  activityLogs            ActivityLog[]

  @@map("user")
}

model Role {
  id          Int    @id @default(autoincrement())
  code        String @unique @db.VarChar(20) // FO, HK, FB, ACC, ADMIN
  name        String @db.VarChar(50)
  permissions Json

  users UserRole[]

  @@map("role")
}

model UserRole {
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

// ============================================================
// MASTER DATA
// ============================================================

model RoomType {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(20)
  name        String  @db.VarChar(50)
  description String? @db.Text
  capacity    Int
  baseRate    Decimal @map("base_rate") @db.Decimal(12, 2) // base rate adjusted per night by PricingRule

  rooms        Room[]
  reservations Reservation[]
  pricingRules PricingRule[]

  @@map("room_type")
}

model Room {
  id         Int        @id @default(autoincrement())
  number     String     @unique @db.VarChar(10)
  floor      Int
  roomTypeId Int        @map("room_type_id")
  status     RoomStatus @default(VC)

  roomType                RoomType                 @relation(fields: [roomTypeId], references: [id])
  reservations            Reservation[]
  housekeepingLogs        HousekeepingLog[]
  housekeepingAssignments HousekeepingAssignment[]
  cleaningSessions        CleaningSession[]
  lostFoundItems          LostFoundItem[]
  activityLogs            ActivityLog[]

  @@map("room")
}

model Article {
  id           Int         @id @default(autoincrement())
  code         String      @unique @db.VarChar(20)
  name         String      @db.VarChar(100)
  type         ArticleType
  defaultPrice Decimal?    @map("default_price") @db.Decimal(12, 2)

  folioLineItems FolioLineItem[]

  @@map("article")
}

model HotelSettings {
  id                   Int     @id @default(1)
  hotelName            String  @map("hotel_name") @db.VarChar(100)
  address              String? @db.Text
  taxPercent           Decimal @map("tax_percent") @db.Decimal(5, 2)
  serviceChargePercent Decimal @map("service_charge_percent") @db.Decimal(5, 2)
  nightAuditTime       String  @map("night_audit_time") @db.VarChar(5)
  currency             String  @default("IDR") @db.VarChar(5)

  @@map("hotel_settings")
}

// ============================================================
// FRONT OFFICE
// ============================================================

model Guest {
  id          Int          @id @default(autoincrement())
  fullName    String       @map("full_name") @db.VarChar(100)
  idType      GuestIdType? @map("id_type")
  idNumber    String?      @map("id_number") @db.VarChar(50)
  phone       String?      @db.VarChar(20)
  email       String?      @db.VarChar(100)
  address     String?      @db.Text
  nationality String?      @db.VarChar(50)
  birthDate   DateTime?    @map("birth_date") @db.Date

  reservations Reservation[]

  @@map("guest")
}

model Reservation {
  id              Int                  @id @default(autoincrement())
  reservationNo   String               @unique @map("reservation_no") @db.VarChar(20)
  type            ReservationUsageType @default(REGULAR)
  arrangementType ArrangementType      @default(RO) @map("arrangement_type")
  reservationType ReservationType      @default(INDIVIDUAL) @map("reservation_type")
  guestId         Int                  @map("guest_id")
  roomTypeId      Int                  @map("room_type_id")
  roomId          Int?                 @map("room_id")
  groupBookingId  String?              @map("group_booking_id") @db.VarChar(32)
  arrivalDate     DateTime             @map("arrival_date") @db.Date
  departureDate   DateTime             @map("departure_date") @db.Date
  adults          Int                  @default(1)
  children        Int                  @default(0)
  status          ReservationStatus    @default(CONFIRMED)
  rateAmount      Decimal              @map("rate_amount") @db.Decimal(12, 2) // compatibility-only resolved first-night rate; SUM(ReservationNight.rateAmount) is authoritative
  deposit         Decimal              @default(0) @db.Decimal(12, 2)
  depositStatus   DepositStatus        @default(PENDING) @map("deposit_status")
  notes           String?              @db.Text

  // GRC fields (inlined from GuestRegistrationCard entity)
  grcFilledAt      DateTime? @map("grc_filled_at")
  purposeOfVisit   String?   @map("purpose_of_visit") @db.VarChar(100)
  signatureDataUrl   String?   @map("signature_data_url") @db.Text
  signedAt           DateTime? @map("signed_at")
  grcSnapshot        Json?     @map("grc_snapshot")
  grcSnapshotVersion Int?      @map("grc_snapshot_version")

  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  guest             Guest                @relation(fields: [guestId], references: [id])
  roomType          RoomType             @relation(fields: [roomTypeId], references: [id])
  room              Room?                @relation(fields: [roomId], references: [id])
  createdBy         User                 @relation("ReservationCreator", fields: [createdById], references: [id])
  folio             Folio?
  activityLogs      ActivityLog[]
  reservationNights ReservationNight[]
  stayFees          ReservationStayFee[]

  @@index([groupBookingId])
  @@map("reservation")
}

model PricingRule {
  id              String                    @id @default(cuid())
  roomTypeId      Int                       @map("room_type_id")
  name            String                    @db.VarChar(255)
  selectorKind    PricingRuleSelectorKind   @map("selector_kind")
  dayOfWeek       PricingRuleDayOfWeek?     @map("day_of_week")
  startsOn        DateTime?                 @map("starts_on") @db.Date
  endsBefore      DateTime?                 @map("ends_before") @db.Date
  adjustmentKind  PricingRuleAdjustmentKind @map("adjustment_kind")
  adjustmentValue Decimal                   @map("adjustment_value") @db.Decimal(12, 2)
  isActive        Boolean                   @default(true) @map("is_active")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@unique([roomTypeId, dayOfWeek])
  @@index([roomTypeId])
  @@map("pricing_rule")
}

model ReservationNight {
  id                  String                       @id @default(cuid())
  reservationId       Int                          @map("reservation_id")
  date                DateTime                     @db.Date
  rateAmount          Decimal                      @map("rate_amount") @db.Decimal(12, 2)
  mealPlan            ArrangementType?             @map("meal_plan")
  mealPax             Int?                         @map("meal_pax")
  mealUnitPrice       Decimal?                     @map("meal_unit_price") @db.Decimal(12, 2)
  mealAmount          Decimal?                     @map("meal_amount") @db.Decimal(12, 2)
  revenueClass        ReservationNightRevenueClass @default(PAID) @map("revenue_class")
  sourcePricingRuleId String?                      @map("source_pricing_rule_id")
  createdAt           DateTime                     @default(now()) @map("created_at")

  reservation    Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folioLineItems FolioLineItem[]

  @@unique([reservationId, date])
  @@index([date])
  @@map("reservation_night")
}

model ReservationStayFee {
  id              Int                      @id @default(autoincrement())
  reservationId   Int                      @map("reservation_id")
  kind            ReservationStayFeeKind
  unitPrice       Decimal                  @map("unit_price") @db.Decimal(12, 2)
  status          ReservationStayFeeStatus @default(PENDING)
  folioLineItemId Int?                     @unique @map("folio_line_item_id")
  selectedById    Int                      @map("selected_by_id")
  selectedAt      DateTime                 @default(now()) @map("selected_at")
  postedAt        DateTime?                @map("posted_at")

  reservation   Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  folioLineItem FolioLineItem? @relation(fields: [folioLineItemId], references: [id], onDelete: Restrict)
  selectedBy    User           @relation(fields: [selectedById], references: [id])

  @@unique([reservationId, kind])
  @@map("reservation_stay_fee")
}

model Folio {
  id            Int         @id @default(autoincrement())
  folioNo       String      @unique @map("folio_no") @db.VarChar(20)
  reservationId Int         @unique @map("reservation_id")
  status        FolioStatus @default(OPEN)
  openedAt      DateTime    @default(now()) @map("opened_at")
  closedAt      DateTime?   @map("closed_at")

  reservation  Reservation     @relation(fields: [reservationId], references: [id])
  lineItems    FolioLineItem[]
  payments     Payment[]
  fbOrders     FBOrder[]       @relation("ChargedFolio")
  activityLogs ActivityLog[]

  @@map("folio")
}

model FolioLineItem {
  id                 Int      @id @default(autoincrement())
  folioId            Int      @map("folio_id")
  articleId          Int      @map("article_id")
  fbOrderId          Int?     @map("fb_order_id")
  reservationNightId String?  @map("reservation_night_id")
  description        String   @db.VarChar(255)
  quantity           Decimal  @default(1) @db.Decimal(8, 2)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  amount             Decimal  @db.Decimal(12, 2)
  postedById         Int      @map("posted_by_id")
  postedAt           DateTime @default(now()) @map("posted_at")

  folio            Folio               @relation(fields: [folioId], references: [id])
  article          Article             @relation(fields: [articleId], references: [id])
  fbOrder          FBOrder?            @relation(fields: [fbOrderId], references: [id])
  reservationNight ReservationNight?   @relation(fields: [reservationNightId], references: [id])
  postedBy         User                @relation(fields: [postedById], references: [id])
  stayFee          ReservationStayFee?

  @@unique([reservationNightId, articleId])
  @@map("folio_line_item")
}

// ============================================================
// FOOD & BEVERAGE (single hardcoded outlet — "Hotel Restaurant")
// ============================================================

model MenuItem {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  category String  @db.VarChar(50)
  price    Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true) @map("is_active")

  orderItems FBOrderItem[]

  @@map("menu_item")
}

model RestaurantTable {
  id        Int           @id @default(autoincrement())
  number    String        @unique @db.VarChar(10)
  capacity  Int           @default(2)
  location  TableLocation @default(INDOOR)
  status    TableStatus   @default(AVAILABLE)
  posX      Int           @default(0) @map("pos_x")
  posY      Int           @default(0) @map("pos_y")
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  orders FBOrder[]

  @@map("restaurant_table")
}

model FBOrder {
  id             Int                @id @default(autoincrement())
  orderNo        String             @unique @map("order_no") @db.VarChar(20)
  tableNo        String?            @map("table_no") @db.VarChar(10)
  tableId        Int?               @map("table_id")
  serviceType    FBOrderServiceType @default(DINE_IN) @map("service_type")
  status         FBOrderStatus      @default(OPEN)
  guestCount     Int                @default(1) @map("guest_count")
  paymentMethod  PaymentMethod?     @map("payment_method")
  chargedFolioId Int?               @map("charged_folio_id")
  subtotal       Decimal            @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal            @default(0) @map("service_charge") @db.Decimal(12, 2)
  tax            Decimal            @default(0) @db.Decimal(12, 2)
  total          Decimal            @default(0) @db.Decimal(12, 2)
  waitedById     Int                @map("waited_by_id")
  openedAt       DateTime           @default(now()) @map("opened_at")
  closedAt       DateTime?          @map("closed_at")

  chargedFolio   Folio?           @relation("ChargedFolio", fields: [chargedFolioId], references: [id])
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  waitedBy       User             @relation(fields: [waitedById], references: [id])
  items          FBOrderItem[]
  folioLineItems FolioLineItem[]
  payments       Payment[]

  @@map("fb_order")
}

model FBOrderItem {
  id         Int     @id @default(autoincrement())
  fbOrderId  Int     @map("fb_order_id")
  menuItemId Int     @map("menu_item_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  amount     Decimal @db.Decimal(12, 2)
  notes      String? @db.VarChar(255)

  fbOrder  FBOrder  @relation(fields: [fbOrderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("fb_order_item")
}

// ============================================================
// HOUSEKEEPING
// ============================================================

model HousekeepingLog {
  id                  Int        @id @default(autoincrement())
  roomId              Int        @map("room_id")
  oldStatus           RoomStatus @map("old_status")
  newStatus           RoomStatus @map("new_status")
  note                String?    @db.Text
  updatedById         Int        @map("updated_by_id")
  updatedAt           DateTime   @default(now()) @map("updated_at")
  cleaningStartedAt   DateTime?  @map("cleaning_started_at")
  cleaningCompletedAt DateTime?  @map("cleaning_completed_at")
  linenChanged        Boolean    @default(false) @map("linen_changed")
  towelChanged        Boolean    @default(false) @map("towel_changed")

  room      Room @relation(fields: [roomId], references: [id])
  updatedBy User @relation(fields: [updatedById], references: [id])

  @@map("housekeeping_log")
}

model HousekeepingAssignment {
  id            Int      @id @default(autoincrement())
  roomId        Int      @map("room_id")
  housekeeperId Int      @map("housekeeper_id")
  date          DateTime @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  room        Room @relation(fields: [roomId], references: [id])
  housekeeper User @relation("HousekeepingAssignmentHousekeeper", fields: [housekeeperId], references: [id])

  @@unique([roomId, date])
  @@index([housekeeperId, date])
  @@index([date])
  @@map("housekeeping_assignment")
}

model CleaningSession {
  id            Int       @id @default(autoincrement())
  roomId        Int       @map("room_id")
  housekeeperId Int       @map("housekeeper_id")
  date          DateTime  @db.Date
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  inspectedAt   DateTime? @map("inspected_at")
  inspectedById Int?      @map("inspected_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  room        Room  @relation(fields: [roomId], references: [id])
  housekeeper User  @relation("CleaningSessionHousekeeper", fields: [housekeeperId], references: [id])
  inspectedBy User? @relation("CleaningSessionInspector", fields: [inspectedById], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([housekeeperId, date])
  @@map("cleaning_session")
}

model LostFoundItem {
  id          Int             @id @default(autoincrement())
  roomId      Int?            @map("room_id")
  description String          @db.Text
  foundById   Int             @map("found_by_id")
  status      LostFoundStatus @default(UNCLAIMED)
  returnedAt  DateTime?       @map("returned_at")
  resolution  String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  room    Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  foundBy User  @relation("LostFoundItemFoundBy", fields: [foundById], references: [id])

  @@index([status])
  @@index([roomId])
  @@map("lost_found_item")
}

// ============================================================
// ACCOUNTING
// ============================================================

model NightAudit {
  id           Int              @id @default(autoincrement())
  businessDate DateTime         @map("business_date") @db.Date
  status       NightAuditStatus @default(COMPLETED)
  runAt        DateTime         @default(now()) @map("run_at")
  runById      Int              @map("run_by_id")
  runBy        User             @relation(fields: [runById], references: [id])

  totalRooms     Int      @map("total_rooms")
  roomsOccupied  Int      @map("rooms_occupied")
  occupancyRate  Decimal  @map("occupancy_rate") @db.Decimal(5, 2)
  roomRevenue    Decimal  @map("room_revenue") @db.Decimal(14, 2)
  fbRevenue      Decimal  @map("fb_revenue") @db.Decimal(14, 2)
  otherRevenue   Decimal  @map("other_revenue") @db.Decimal(14, 2)
  totalRevenue   Decimal  @map("total_revenue") @db.Decimal(14, 2)
  checkInCount   Int      @map("check_in_count")
  checkOutCount  Int      @map("check_out_count")
  inHouseCount   Int      @map("in_house_count")
  roomNightsSold Int?     @map("room_nights_sold")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([businessDate])
  @@map("night_audit")
}

// ============================================================
// PAYMENT (polymorphic — exactly one of folioId / fbOrderId)
// ============================================================

model Payment {
  id           Int            @id @default(autoincrement())
  amount       Decimal        @db.Decimal(12, 2)
  method       PaymentMethod
  purpose      PaymentPurpose @default(PAYMENT)
  reference    String?        @db.VarChar(100)
  folioId      Int?           @map("folio_id")
  fbOrderId    Int?           @map("fb_order_id")
  receivedById Int            @map("received_by_id")
  receivedAt   DateTime       @default(now()) @map("received_at")

  folio      Folio?   @relation(fields: [folioId], references: [id])
  fbOrder    FBOrder? @relation(fields: [fbOrderId], references: [id])
  receivedBy User     @relation(fields: [receivedById], references: [id])

  @@map("payment")
}

// ============================================================
// ACTIVITY LOG (general audit trail)
// ============================================================

model ActivityLog {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  action        ActivityAction
  createdAt     DateTime       @default(now()) @map("created_at")
  reservationId Int?           @map("reservation_id")
  folioId       Int?           @map("folio_id")
  roomId        Int?           @map("room_id")
  metadata      Json?

  user        User         @relation(fields: [userId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  folio       Folio?       @relation(fields: [folioId], references: [id], onDelete: SetNull)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_log")
}
